# Shopify live mode (server-side only). Leave unset to use the built-in demo catalog.
SHOPIFY_SHOP=your-development-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me

# Optional AI drafting. Deterministic templates remain available when unset.
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-5.6-terra

# Emergency server-side kill switch. Writes fail closed unless this is exactly true.
ALLOW_LIVE_WRITES=false

# Set to true only when deployed with the server routes above configured.
VITE_USE_LIVE_API=false
